# Tour Guide AI - Environment Configuration Example
# Copy this file to .env and insert your real keys/values.

# Gemini API Key (get yours from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest

# Database
DATABASE_URL=sqlite+aiosqlite:///./tour_guide.db

# Application
APP_NAME=Tour Guide AI
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Conversation
MAX_CONTEXT_MESSAGES=20
